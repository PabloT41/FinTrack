
@model FinTrack.Models.Movimiento

@{
    ViewData["Title"] = "Editar movimiento";
}

<h2>Editar Movimiento Financiero</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">

    @Html.AntiForgeryToken()

    <!-- Identificador del movimiento -->
    <input type="hidden" asp-for="Id" />

    <!-- Resumen de errores -->
    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <!-- Concepto -->
    <div class="mb-3">
        <label asp-for="Concepto" class="form-label"></label>
        <input asp-for="Concepto" class="form-control" />
        <span asp-validation-for="Concepto"
              class="text-danger"></span>
    </div>

    <!-- Monto -->
    <div class="mb-3">
        <label asp-for="Monto" class="form-label"></label>
        <input asp-for="Monto"
               class="form-control"
               type="number"
               step="0.01"
               min="0.01" />
        <span asp-validation-for="Monto"
              class="text-danger"></span>
    </div>

    <!-- Fecha -->
    <div class="mb-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha"
               type="date"
               class="form-control" />
        <span asp-validation-for="Fecha"
              class="text-danger"></span>
    </div>

    <!-- Categoría relacionada -->
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label">
            Categoría
        </label>

        <select asp-for="CategoriaId"
                asp-items="ViewBag.Categorias"
                class="form-select">
            <option value="0">Seleccione una categoría</option>
        </select>

        <span asp-validation-for="CategoriaId"
              class="text-danger"></span>
    </div>

    <!-- Descripción -->
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion"
                  class="form-control"
                  rows="3"></textarea>
    </div>

    <!-- Botones -->
    <div class="mt-4">
        <button type="submit" class="btn btn-success">
            Guardar cambios
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
