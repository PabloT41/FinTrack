
@model FinTrack.Models.Movimiento

@{
    ViewData["Title"] = "Nuevo movimiento";
}

<h2>Registrar Movimiento</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Concepto" class="form-label"></label>
        <input asp-for="Concepto" class="form-control" />
        <span asp-validation-for="Concepto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Monto" class="form-label"></label>
        <input asp-for="Monto" class="form-control"
               type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" type="date" class="form-control" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label">
            Categoría
        </label>

        <select asp-for="CategoriaId"
                asp-items="ViewBag.Categorias"
                class="form-select">
            <option value="0">Seleccione una categoría</option>
        </select>

        <span asp-validation-for="CategoriaId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion"
                  class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">
        Guardar movimiento
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
