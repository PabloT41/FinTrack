
@model IEnumerable<FinTrack.Models.Movimiento>

@{
    ViewData["Title"] = "Movimientos";
}

<h2>Movimientos Financieros</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Nuevo movimiento
</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Fecha</th>
            <th>Concepto</th>
            <th>Categoría</th>
            <th>Tipo</th>
            <th>Monto</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@m.Concepto</td>
                <td>@m.Categoria?.Nombre</td>
                <td>@m.Categoria?.Tipo</td>
                <td>@m.Monto.ToString("N2")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@m.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@m.Id"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger btn-sm"
                                onclick="return confirm('¿Eliminar movimiento?')">
                            Eliminar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
